 5 END
 10  HIMEM: 4 * 4096
 20  PRINT CHR$(4);"BLOAD LASER.DRAW"
 30  PRINT CHR$(4);"BLOAD LASER.SHAPES"
 40  PRINT CHR$(4);"BLOAD TBLD"
 50  PRINT CHR$(4);"BLOAD GUNCODE"
 60  PRINT CHR$(4);"BLOAD GAME"
 70  PRINT CHR$(4);"BLOAD START"
 80  PRINT CHR$(4);"BLOAD FONT"
 90  PRINT CHR$(4);"BLOAD GFXTABLES"
 100  CALL 6 * 4096

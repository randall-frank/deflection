 10  HIMEM: 8 * 4096
 20  POKE 232,240: POKE 233,144
 30  SCALE= 1: ROT= 0
 40  PRINT CHR$(4);"BLOAD LASER.DRAW"
 50  PRINT CHR$(4);"BLOAD LASER.SHAPES"
 55  HOME 
 60  VTAB 23: HTAB 1
 100  HGR : GOSUB 1000: HCOLOR= 3: HPLOT 22,0 TO 22,20 TO 0,20: HPLOT 23,0 TO 23,20
 105  IF HI = 1 THEN  HPLOT 30,10 TO 35,10 TO 35,15 TO 30,15 TO 30,10
 106  IF HI = 1 THEN  HCOLOR= 4: FOR X = 0 TO 18: HPLOT 0,X TO 19,X: NEXT X
 110 XC = 0:YC = 0: XDRAW 1 AT XC,YC
 120  GET A$
 121 S = 0
 122  XDRAW 1 AT XC,YC
 125  IF A$ = "I" THEN S = 1:YC = YC - 1
 130  IF A$ = "M" THEN S = 1:YC = YC + 1
 140  IF A$ = "J" THEN S = 1:XC = XC - 1
 150  IF A$ = "K" THEN S = 1:XC = XC + 1
 160  IF A$ = " " THEN 120
 170  IF A$ = "E" OR A$ = "Q" OR A$ = "S" OR A$ = "C" OR A$ = "T" THEN 500
 180  IF S = 0 THEN 120
 190  IF XC > 20 THEN XC = 20
 200  IF XC < 0 THEN XC = 0
 210  IF YC > 18 THEN YC = 18
 220  IF YC < 0 THEN YC = 0
 230  XDRAW 1 AT XC,YC
 240  GOTO 120
 500  IF A$ = "E" THEN 550
 510  IF A$ = "Q" THEN 2000
 520  IF A$ = "S" THEN 580
 530  IF A$ = "C" THEN 100
 535  IF A$ = "T" THEN HI =  NOT HI: GOTO 100
 540  XDRAW 1 AT XC,YC: GOTO 120
 550  INPUT "ENTER NUMBER TO EDIT:";N
 560  POKE 0,0: POKE 1,0: POKE 2,N: POKE 4,1: POKE 5,2: CALL 9 * 4096: GOTO 110
 580  INPUT "ENTER NUMBER TO SAVE:";N
 590  POKE 2,N: CALL 9 * 4096 + 256: GOTO 100
 1000  FOR X = 0 TO 6
 1010  FOR Y = 0 TO 9
 1015  IF X = 6 AND Y >  = 4 THEN 1030
 1020  POKE 0,Y * 4: POKE 1,30 + 20 * X: POKE 2,X * 10 + Y: POKE 4,1: POKE 5,2
 1021  CALL 9 * 4096
 1030  NEXT Y,X
 1040  RETURN 
 2000  TEXT : PRINT "SAVE THE FILE(Y/N):";: GET A$: IF A$ <  > "Y" AND A$ <  > "N" THEN 2000
 2010  IF A$ = "Y" THEN  PRINT : PRINT CHR$(4);"BSAVE LASER.SHAPES,A$8000,L$FFF"
